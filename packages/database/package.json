{
  "name": "@mind-plus/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camada Prisma central do MIND + para PostgreSQL Neon.",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "prisma generate --watch",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "lint": "eslint src --ignore-pattern src/generated/**",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
